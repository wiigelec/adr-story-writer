    "does_not_accept_or_reject_story_meaning": true,
    "does_not_change_authority_class": true,
    "does_not_change_manuscript_acceptance": true,
    "does_not_change_production_approval": true,
    "does_not_imply_migration_success": true
  },
  "transition_provenance": {
    "dataset_field": "compatibility_history",
    "required_fields": [
      "source_realization",
      "target_realization",
      "operation",
      "unresolved_decisions_or_losses",
      "semantic_author_decision_required"
    ],
    "is_not_story_authority": true
  },
  "persistence": {
    "coherent_target_required": true,
    "atomic_replace_required_for_file_backend": true,
    "partial_target_must_not_be_reported_as_success": true
  },
  "failure": {
    "unknown_schema_or_ruleset_fails_safe": true,
    "allowed_paths": [
      "restricted_inspection",
      "diagnostic_reporting",
      "recovery",
      "migration",
      "rebinding",
      "refusal"
    ],
    "must_not_invent_schema_mapping": true,
    "must_not_invent_semantic_interpretation": true
  },
  "dataset_boundary": {
    "story_instance_state_external_to_ruleset_repository": true,
    "reverse_ruleset_to_dataset_instance_binding_forbidden": true
